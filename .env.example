# MySQL Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=crm_database
DB_PORT=3306

# Auth
JWT_SECRET=replace_with_a_long_random_secret

# Server
PORT=5000
NODE_ENV=development

# CORS — comma-separated list of extra allowed origins (Vercel preview/production URLs).
# *.vercel.app and localhost are always allowed automatically.
CORS_ORIGIN=
